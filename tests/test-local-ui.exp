#!/usr/bin/expect -f
set timeout 120

if {$argc != 1} {
  puts stderr "usage: test-local-ui.exp /path/to/install-jellyfin-stack.sh"
  exit 2
}

set installer [lindex $argv 0]
spawn env TERM=xterm-256color bash $installer --dry-run --media-storage local

expect -re {Default Settings.*recommended}
send -- "\r"

expect -re {Onboard Proxmox storage}
send -- "\r"

expect -re {Proxmox storage pool}
send -- "\r"

expect -re {Media disk size in GB}
send -- "\r"

expect -re {Enable a second NFS mount}
send -- "\r"

expect -re {Enter NordVPN manual-setup credentials}
send -- "\r"

expect -re {Admin username for Jellyfin}
send -- "\r"

expect -re {Admin password.*12\+ characters}
send -- "\r"

after 750
send -- "\r"

expect -re {onboard .*:100G -> /mnt/nas}
expect -re {Dry run completed successfully}
expect eof

set result [wait]
exit [lindex $result 3]
