# Copy to /opt/mediastack/.env inside the LXC or pass values to the installer.
# Do not commit real VPN credentials or generated secrets.

NORDVPN_USER=CHANGE_ME
NORDVPN_PASS=CHANGE_ME
NORDVPN_COUNTRIES=United States

TZ=America/New_York
PUID=65534
PGID=65534

# One login chosen in the installer and reused for the user-facing admin UIs.
# Use at least 12 characters so it also satisfies Portainer's requirements.
MEDIASTACK_ADMIN_USER=admin
MEDIASTACK_ADMIN_PASSWORD=CHANGE_ME_GENERATE_RANDOM

VPN_TYPE=openvpn
FIREWALL=on
FIREWALL_VPN_INPUT_PORTS=6881
FIREWALL_OUTBOUND_SUBNETS=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# AMD GPU (VAAPI) only. The installer detects these from inside the LXC; set
# them manually if Jellyfin cannot open /dev/dri/renderD128.
# RENDER_GID=104
# VIDEO_GID=44
# LIBVA_DRIVER_NAME=radeonsi

JELLYSTAT_DB_PASS=CHANGE_ME_GENERATE_RANDOM
JELLYSTAT_JWT_SECRET=CHANGE_ME_GENERATE_RANDOM
HOMARR_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_RANDOM

# Generated by the installer and used for unattended first-run configuration.
HOMARR_ADMIN_USER=admin
HOMARR_ADMIN_PASSWORD=CHANGE_ME_GENERATE_RANDOM
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=CHANGE_ME_GENERATE_RANDOM
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASSWORD=CHANGE_ME_GENERATE_RANDOM
PROFILARR_ADMIN_USER=admin
PROFILARR_ADMIN_PASSWORD=CHANGE_ME_GENERATE_RANDOM
PORTAINER_ADMIN_USER=admin
PORTAINER_ADMIN_PASSWORD=CHANGE_ME_GENERATE_RANDOM

# Persisted installer choices used by /usr/local/sbin/mediastack-finish-setup.
QNAP_ENABLED=0
APPLY_TRASH=1
SUBTITLE_REPAIR_TIMER_ENABLED=1
